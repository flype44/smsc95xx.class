; Roadshow interface file for smsc95xx.device (SMSC LAN95xx USB Ethernet, e.g. the
; network port of a Raspberry Pi 3B). Copy it to DEVS:NetInterfaces/smsc95xx and run
; "AddNetInterface smsc95xx" after Poseidon has bound the Ethernet controller.
DEVICE=smsc95xx.device
UNIT=0
CONFIGURE=DHCP

; Roadshow's defaults (32 read and 32 write requests) are too few for this device:
; a receive burst uses up to about 50 read requests, and the write queue fills up.
; REQUIRESINITDELAY and COPYMODE=SLOW are workarounds for the Ariadne card only.
IPREQUESTS=128
WRITEREQUESTS=128
ARPREQUESTS=8
REQUIRESINITDELAY=NO
COPYMODE=FAST
